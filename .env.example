# GdPicture.API license key used by the .NET TWAIN service. Empty = evaluation mode.
GDPICTURE_LICENSE_KEY=

# Folder that holds the OCR resources (eng.traineddata). Empty = C:\GdPicture.NET 14\Redist\OCR.
# If the folder does not exist, pages are saved without OCR.
GDPICTURE_OCR_RESOURCES_PATH=

# Nutrient Web SDK license key used by the web client. Empty = evaluation mode.
VITE_NUTRIENT_WEB_LICENSE_KEY=

# URL of the .NET TWAIN service, as seen from the browser.
VITE_TWAIN_API_URL=http://localhost:5000
